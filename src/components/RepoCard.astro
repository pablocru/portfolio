---
import type { PortfolioRepo } from "../types/repo.type";

interface Props {
  repo: PortfolioRepo;
}

const { repo } = Astro.props;
---

<article>
  <h4><a href={repo.url}>{repo.name}</a></h4>
  {repo.description !== null && <p>{repo.description}</p>}
  {repo.language !== null && <p>{repo.language}</p>}
  {repo.archived && <p>Archived</p>}
</article>
