---
import { getCollection } from "astro:content";
import { createGitHubClient } from "../clients/github.client";
import Profile from "../components/Profile.astro";
import Repositories from "../components/repositories/Repositories.astro";
import Layout from "../layouts/Layout.astro";
import { getProfile } from "../services/portfolio.service";

const client = createGitHubClient();
const profile = await getProfile(client);
const repoEntries = await getCollection("repos");
const repos = repoEntries.map((entry) => entry.data);
---

<Layout title={`Portfolio of ${profile.name}`}>
  <main>
    <Profile profile={profile} />
    <Repositories repos={repos} />
  </main>
</Layout>
